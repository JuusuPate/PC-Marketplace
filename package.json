{
  "name": "pc-marketplace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pc-marketplace/web",
    "build": "npm run build --workspace @pc-marketplace/web",
    "typecheck": "npm run typecheck --workspace @pc-marketplace/web",
    "test": "vitest run --config apps/web/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.6",
    "vitest": "^5.0.1"
  }
}
